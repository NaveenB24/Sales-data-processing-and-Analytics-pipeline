# Copy to backend/.env and adjust. Every value has a working default.
ENVIRONMENT=development
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440

DATABASE_URL=sqlite:///./data/sales.db

WORKER_POOL_SIZE=8
ROW_PROCESSING_DELAY_MS=2
ROW_MAX_RETRIES=2
PROGRESS_EMIT_EVERY=25
DB_INSERT_CHUNK_SIZE=1000
VARIANCE_CV_THRESHOLD=1.0

MAX_UPLOAD_MB=50
UPLOAD_RATE_LIMIT=20
UPLOAD_RATE_WINDOW_SECONDS=60

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
LOG_JSON=true
